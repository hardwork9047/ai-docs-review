# ローカル起動(make dev / make serve)用の設定。`cp .env.example .env` して値を入れる。
# .env は git 管理外。URL や認証情報は公開リポジトリに載せないこと。

# Ollama の URL
#   Modal:  `make modal-deploy` が表示した https://<workspace>--buchou-review-ollama-ollama.modal.run
#   Colab:  Cloudflare Quick Tunnel の https://xxxx.trycloudflare.com
#   ローカル: http://localhost:11434
REVIEW_OLLAMA_URL=https://xxxx.modal.run

# Modal の proxy auth(ダッシュボードで作った Proxy Auth Token)。Colab / ローカルなら不要
REVIEW_OLLAMA_HEADERS={"Modal-Key": "wk-...", "Modal-Secret": "ws-..."}

# 必要に応じて(既定値は backend/src/app/infra/settings.py)
# REVIEW_MODEL=gemma4:e2b
# REVIEW_THINK=false
