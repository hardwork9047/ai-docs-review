# ローカル起動(make dev / make serve)用の設定。`cp .env.example .env` して値を入れる。
# .env は git 管理外。Colab のトンネル URL は公開リポジトリに載せないこと。

# Google Colab の Ollama を Cloudflare Quick Tunnel で公開した URL(ローカルの Ollama なら http://localhost:11434)
REVIEW_OLLAMA_URL=https://xxxx.trycloudflare.com

# 必要に応じて(既定値は backend/src/app/infra/settings.py)
# REVIEW_MODEL=gemma4:e2b
# REVIEW_THINK=false
